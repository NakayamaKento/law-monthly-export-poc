{
    "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
      "$connections": { "type": "Object", "defaultValue": {} },
      "COLUMNS": { "type": "Array" },
      "KQL_BODY": { "type": "String" },
      "MONTH_OVERRIDE": { "type": "String", "defaultValue": "" },
      "LAW_RESOURCE_ID": { "type": "String" },
      "STORAGE_ACCOUNT_NAME": { "type": "String" }
    },
    "triggers": {
      "Monthly_JST_5th_0900": {
        "type": "Recurrence",
        "recurrence": {
          "frequency": "Month",
          "interval": 1,
          "timeZone": "Tokyo Standard Time",
          "startTime": "2026-12-05T09:00:00"
        },
        "runtimeConfiguration": { "concurrency": { "runs": 1 } }
      }
    },
    "actions": {
      "Export": {
        "type": "Scope",
        "runAfter": {},
        "actions": {
          "RunStartedUtc": {
            "type": "Compose",
            "runAfter": {},
            "inputs": "@utcNow()"
          },
          "Settings_Columns": {
            "type": "Compose",
            "runAfter": { "RunStartedUtc": ["Succeeded"] },
            "inputs": "@parameters('COLUMNS')"
          },
          "Settings_KqlBody": {
            "type": "Compose",
            "runAfter": { "Settings_Columns": ["Succeeded"] },
            "inputs": "@parameters('KQL_BODY')"
          },
          "Check_Settings": {
            "type": "If",
            "runAfter": { "Settings_KqlBody": ["Succeeded"] },
            "expression": {
              "or": [
                { "equals": ["@empty(outputs('Settings_Columns'))", true] },
                { "equals": ["@empty(trim(outputs('Settings_KqlBody')))", true] },
                { "not": { "equals": ["@length(union(outputs('Settings_Columns'),outputs('Settings_Columns')))", "@length(outputs('Settings_Columns'))"] } }
              ]
            },
            "actions": {
              "Terminate_Settings": {
                "type": "Terminate",
                "inputs": { "runStatus": "Failed", "runError": { "code": "InvalidSettings", "message": "KQL_BODY and unique COLUMNS are required" } }
              }
            },
            "else": { "actions": {} }
          },
          "StartJst": {
            "type": "Compose",
            "runAfter": { "Check_Settings": ["Succeeded"] },
            "inputs": "@if(empty(parameters('MONTH_OVERRIDE')), addToTime(formatDateTime(convertTimeZone(outputs('RunStartedUtc'),'UTC','Tokyo Standard Time'),'yyyy-MM-01T00:00:00'),-1,'Month','yyyy-MM-ddTHH:mm:ss'), concat(parameters('MONTH_OVERRIDE'),'-01T00:00:00'))"
          },
          "EndJst": {
            "type": "Compose",
            "runAfter": { "StartJst": ["Succeeded"] },
            "inputs": "@addToTime(outputs('StartJst'),1,'Month','yyyy-MM-ddTHH:mm:ss')"
          },
          "StartUtc": {
            "type": "Compose",
            "runAfter": { "EndJst": ["Succeeded"] },
            "inputs": "@convertTimeZone(outputs('StartJst'),'Tokyo Standard Time','UTC','yyyy-MM-ddTHH:mm:ss')"
          },
          "EndUtc": {
            "type": "Compose",
            "runAfter": { "StartUtc": ["Succeeded"] },
            "inputs": "@convertTimeZone(outputs('EndJst'),'Tokyo Standard Time','UTC','yyyy-MM-ddTHH:mm:ss')"
          },
          "Month": {
            "type": "Compose",
            "runAfter": { "EndUtc": ["Succeeded"] },
            "inputs": "@substring(outputs('StartJst'),0,7)"
          },
          "RunStampJst": {
            "type": "Compose",
            "runAfter": { "Month": ["Succeeded"] },
            "inputs": "@concat(convertTimeZone(outputs('RunStartedUtc'),'UTC','Tokyo Standard Time','yyyyMMdd-HHmmss'),'-JST')"
          },
          "OutputNames": {
            "type": "Compose",
            "runAfter": { "RunStampJst": ["Succeeded"] },
            "inputs": {
              "csvFileName": "@concat(workflow().name,'_',outputs('Month'),'_',outputs('RunStampJst'),'.csv')",
              "runFolder": "@concat(workflow().name,'/',outputs('Month'),'/runs/',outputs('RunStampJst'),'_',workflow().run.name)"
            }
          },
          "QueryText": {
            "type": "Compose",
            "runAfter": { "OutputNames": ["Succeeded"] },
            "inputs": "@concat('let start=datetime(', outputs('StartUtc'), '); let end=datetime(', outputs('EndUtc'), '); ', outputs('Settings_KqlBody'))"
          },
          "Query": {
            "type": "ApiConnection",
            "runAfter": { "QueryText": ["Succeeded"] },
            "inputs": {
              "host": { "connection": { "name": "@parameters('$connections')['azuremonitorlogs']['connectionId']" } },
              "method": "post",
              "path": "/queryDataV2",
              "queries": {
                "subscriptions": "@split(parameters('LAW_RESOURCE_ID'), '/')[2]",
                "resourcegroups": "@split(parameters('LAW_RESOURCE_ID'), '/')[4]",
                "resourcetype": "Log Analytics Workspace",
                "resourcename": "@split(parameters('LAW_RESOURCE_ID'), '/')[8]"
              },
              "body": {
                "query": "@outputs('QueryText')",
                "timerangetype": "3",
                "timerange": {}
              },
              "retryPolicy": { "type": "fixed", "count": 3, "interval": "PT30S" }
            }
          },
          "Check_Query_Error": {
            "type": "If",
            "runAfter": { "Query": ["Succeeded"] },
            "expression": { "and": [ { "not": { "equals": [ "@empty(body('Query')?['error'])", true ] } } ] },
            "actions": {
              "Terminate_QueryError": {
                "type": "Terminate",
                "inputs": { "runStatus": "Failed", "runError": { "code": "QueryError", "message": "Log Analytics returned error/PartialError" } }
              }
            },
            "else": { "actions": {} }
          },
          "Rows": {
            "type": "ParseJson",
            "runAfter": { "Check_Query_Error": ["Succeeded"] },
            "inputs": {
              "content": "@body('Query')",
              "schema": {
                "type": "object",
                "required": ["value"],
                "properties": {
                  "value": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": ["bag"],
                      "properties": { "bag": { "type": ["object", "string"] } }
                    }
                  }
                }
              }
            }
          },
          "RowCount": {
            "type": "Compose",
            "runAfter": { "Rows": ["Succeeded"] },
            "inputs": "@length(body('Rows')['value'])"
          },
          "Check_Row_Cap": {
            "type": "If",
            "runAfter": { "RowCount": ["Succeeded"] },
            "expression": { "and": [ { "greaterOrEquals": [ "@outputs('RowCount')", 500000 ] } ] },
            "actions": {
              "Terminate_RowCap": {
                "type": "Terminate",
                "inputs": { "runStatus": "Failed", "runError": { "code": "RowCap", "message": "Row count reached API limit; split the window" } }
              }
            },
            "else": { "actions": {} }
          },
          "Records": {
            "type": "Select",
            "runAfter": { "Check_Row_Cap": ["Succeeded"] },
            "inputs": { "from": "@body('Rows')['value']", "select": "@json(string(item()['bag']))" }
          },
          "Check_Record_Columns": {
            "type": "ParseJson",
            "runAfter": { "Records": ["Succeeded"] },
            "inputs": {
              "content": "@body('Records')",
              "schema": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": "@outputs('Settings_Columns')"
                }
              }
            }
          },
          "Create_CSV_table": {
            "type": "Table",
            "runAfter": { "Check_Record_Columns": ["Succeeded"] },
            "inputs": {
              "from": "@body('Records')",
              "format": "CSV",
              "columns": [
                { "header": "TimeGenerated", "value": "@item()['TimeGenerated']" },
                { "header": "Id", "value": "@item()['Id']" },
                { "header": "Text", "value": "@item()['Text']" }
              ]
            }
          },
          "CsvText": {
            "type": "Compose",
            "runAfter": { "Create_CSV_table": ["Succeeded"] },
            "inputs": "@if(equals(outputs('RowCount'),0), concat(join(outputs('Settings_Columns'),','), decodeUriComponent('%0D%0A')), body('Create_CSV_table'))"
          },
          "Check_Header": {
            "type": "If",
            "runAfter": { "CsvText": ["Succeeded"] },
            "expression": { "and": [ { "not": { "equals": [ "@trim(first(split(outputs('CsvText'), decodeUriComponent('%0A'))))", "@join(outputs('Settings_Columns'),',')" ] } } ] },
            "actions": {
              "Terminate_SchemaMismatch": {
                "type": "Terminate",
                "inputs": { "runStatus": "Failed", "runError": { "code": "SchemaMismatch", "message": "CSV header differs from expected columns" } }
              }
            },
            "else": { "actions": {} }
          },
          "Upload_CSV": {
            "type": "ApiConnection",
            "runAfter": { "Check_Header": ["Succeeded"] },
            "inputs": {
              "host": { "connection": { "name": "@parameters('$connections')['azureblob']['connectionId']" } },
              "method": "post",
              "path": "/v2/datasets/@{encodeURIComponent(encodeURIComponent(parameters('STORAGE_ACCOUNT_NAME')))}/files",
              "headers": { "Content-Type": "text/csv; charset=utf-8", "ReadFileMetadataFromServer": true },
              "queries": {
                "folderPath": "/exports/@{outputs('OutputNames')['runFolder']}",
                "name": "@outputs('OutputNames')['csvFileName']",
                "queryParametersSingleEncoded": true
              },
              "body": "@concat(uriComponentToString('%EF%BB%BF'), outputs('CsvText'))",
              "retryPolicy": { "type": "fixed", "count": 3, "interval": "PT10S" }
            },
            "description": "CreateFile_V2 replaces a same-name blob. Retries write the identical payload to this run-specific path."
          },
          "Read_Back_CSV": {
            "type": "ApiConnection",
            "runAfter": { "Upload_CSV": ["Succeeded"] },
            "inputs": {
              "host": { "connection": { "name": "@parameters('$connections')['azureblob']['connectionId']" } },
              "method": "get",
              "path": "/v2/datasets/@{encodeURIComponent(encodeURIComponent(parameters('STORAGE_ACCOUNT_NAME')))}/files/@{encodeURIComponent(encodeURIComponent(body('Upload_CSV')['Id']))}/content",
              "queries": { "inferContentType": false },
              "retryPolicy": { "type": "fixed", "count": 3, "interval": "PT10S" }
            },
            "description": "GetFileContent_V2 reads the saved bytes as a binary content envelope, not inferred text."
          },
          "Check_Read_Back_CSV": {
            "type": "If",
            "runAfter": { "Read_Back_CSV": ["Succeeded"] },
            "expression": {
              "or": [
                { "equals": ["@empty(body('Read_Back_CSV')?['$content'])", true] },
                { "not": { "equals": ["@body('Read_Back_CSV')?['$content']", "@base64(concat(uriComponentToString('%EF%BB%BF'),outputs('CsvText')))"] } }
              ]
            },
            "actions": {
              "Terminate_Read_Back_Mismatch": {
                "type": "Terminate",
                "inputs": { "runStatus": "Failed", "runError": { "code": "ReadBackMismatch", "message": "Saved CSV binary envelope is missing or bytes differ, including UTF-8 BOM; current was not published" } }
              }
            },
            "else": { "actions": {} },
            "description": "Compare base64 bytes exactly, avoiding text decoding, newline normalization or BOM stripping."
          },
          "Manifest": {
            "type": "Compose",
            "runAfter": { "Check_Read_Back_CSV": ["Succeeded"] },
            "inputs": {
              "workflowName": "@{workflow().name}",
              "month": "@{outputs('Month')}",
              "runId": "@{workflow().run.name}",
              "startedAtUtc": "@outputs('RunStartedUtc')",
              "windowStartUtc": "@{outputs('StartUtc')}",
              "windowEndUtc": "@{outputs('EndUtc')}",
              "rowCount": "@outputs('RowCount')",
              "files": ["@outputs('OutputNames')['csvFileName']"],
              "csvReadBackVerified": true,
              "completedAtUtc": "@{utcNow()}"
            }
          },
          "Upload_Manifest": {
            "type": "ApiConnection",
            "runAfter": { "Manifest": ["Succeeded"] },
            "inputs": {
              "host": { "connection": { "name": "@parameters('$connections')['azureblob']['connectionId']" } },
              "method": "post",
              "path": "/v2/datasets/@{encodeURIComponent(encodeURIComponent(parameters('STORAGE_ACCOUNT_NAME')))}/files",
              "headers": { "Content-Type": "application/json; charset=utf-8", "ReadFileMetadataFromServer": true },
              "queries": {
                "folderPath": "/exports/@{outputs('OutputNames')['runFolder']}",
                "name": "manifest.json",
                "queryParametersSingleEncoded": true
              },
              "body": "@string(outputs('Manifest'))",
              "retryPolicy": { "type": "fixed", "count": 3, "interval": "PT10S" }
            },
            "description": "CreateFile_V2 replaces only this run's manifest on retry; earlier runs are retained."
          },
          "Current": {
            "type": "Compose",
            "runAfter": { "Upload_Manifest": ["Succeeded"] },
            "inputs": {
              "workflowName": "@{workflow().name}",
              "runId": "@{workflow().run.name}",
              "path": "@concat(outputs('OutputNames')['runFolder'],'/')",
              "csvFileName": "@outputs('OutputNames')['csvFileName']"
            }
          },
          "Upload_Current": {
            "type": "ApiConnection",
            "runAfter": { "Current": ["Succeeded"] },
            "inputs": {
              "host": { "connection": { "name": "@parameters('$connections')['azureblob']['connectionId']" } },
              "method": "post",
              "path": "/v2/datasets/@{encodeURIComponent(encodeURIComponent(parameters('STORAGE_ACCOUNT_NAME')))}/files",
              "headers": { "Content-Type": "application/json; charset=utf-8", "ReadFileMetadataFromServer": true },
              "queries": {
                "folderPath": "/exports/@{workflow().name}/@{outputs('Month')}",
                "name": "current.json",
                "queryParametersSingleEncoded": true
              },
              "body": "@string(outputs('Current'))",
              "retryPolicy": { "type": "fixed", "count": 3, "interval": "PT10S" }
            },
            "description": "CreateFile_V2 creates or replaces current.json last. Retries use the same pointer. A lost response can report failure after publication; inspect current before retrying."
          }
        }
      },
      "Fail_if_Export_Failed": {
        "type": "Terminate",
        "runAfter": { "Export": ["Failed", "TimedOut"] },
        "inputs": { "runStatus": "Failed", "runError": { "code": "ExportFailed", "message": "Export scope failed; inspect actions and stored current.json before retrying" } }
      }
    },
    "outputs": {}
}
