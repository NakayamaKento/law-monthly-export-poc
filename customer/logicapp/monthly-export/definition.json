{
  "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
  "contentVersion": "1.0.0.0",
  "triggers": {
    "Monthly_JST_5th_0900": {
      "type": "Recurrence",
      "recurrence": {
        "frequency": "Month",
        "interval": 1,
        "timeZone": "Tokyo Standard Time",
        "schedule": {
          "monthDays": [
            5
          ],
          "hours": [
            9
          ],
          "minutes": [
            0
          ]
        }
      },
      "runtimeConfiguration": {
        "concurrency": {
          "runs": 1
        }
      }
    }
  },
  "actions": {
    "Export": {
      "type": "Scope",
      "runAfter": {},
      "actions": {
        "Settings_Columns": {
          "type": "Compose",
          "runAfter": {},
          "inputs": "@split(appsetting('COLUMNS'), ',')"
        },
        "Settings_KqlBody": {
          "type": "Compose",
          "runAfter": {
            "Settings_Columns": [
              "Succeeded"
            ]
          },
          "inputs": "@appsetting('KQL_BODY')"
        },
        "StartJst": {
          "type": "Compose",
          "runAfter": {
            "Settings_KqlBody": [
              "Succeeded"
            ]
          },
          "inputs": "@if(empty(appsetting('MONTH_OVERRIDE')), addToTime(formatDateTime(convertTimeZone(utcNow(),'UTC','Tokyo Standard Time'),'yyyy-MM-01T00:00:00'),-1,'Month','yyyy-MM-ddTHH:mm:ss'), concat(appsetting('MONTH_OVERRIDE'),'-01T00:00:00'))"
        },
        "EndJst": {
          "type": "Compose",
          "runAfter": {
            "StartJst": [
              "Succeeded"
            ]
          },
          "inputs": "@addToTime(outputs('StartJst'),1,'Month','yyyy-MM-ddTHH:mm:ss')"
        },
        "StartUtc": {
          "type": "Compose",
          "runAfter": {
            "EndJst": [
              "Succeeded"
            ]
          },
          "inputs": "@convertTimeZone(outputs('StartJst'),'Tokyo Standard Time','UTC','yyyy-MM-ddTHH:mm:ss')"
        },
        "EndUtc": {
          "type": "Compose",
          "runAfter": {
            "StartUtc": [
              "Succeeded"
            ]
          },
          "inputs": "@convertTimeZone(outputs('EndJst'),'Tokyo Standard Time','UTC','yyyy-MM-ddTHH:mm:ss')"
        },
        "Month": {
          "type": "Compose",
          "runAfter": {
            "EndUtc": [
              "Succeeded"
            ]
          },
          "inputs": "@substring(outputs('StartJst'),0,7)"
        },
        "QueryText": {
          "type": "Compose",
          "runAfter": {
            "Month": [
              "Succeeded"
            ]
          },
          "inputs": "@concat('let start=datetime(', outputs('StartUtc'), '); let end=datetime(', outputs('EndUtc'), '); ', outputs('Settings_KqlBody'))"
        },
        "Query": {
          "type": "ApiConnection",
          "runAfter": {
            "QueryText": [
              "Succeeded"
            ]
          },
          "inputs": {
            "host": {
              "connection": {
                "referenceName": "azuremonitorlogs"
              }
            },
            "method": "post",
            "path": "/queryDataV2",
            "queries": {
              "subscriptions": "@split(appsetting('LAW_RESOURCE_ID'), '/')[2]",
              "resourcegroups": "@split(appsetting('LAW_RESOURCE_ID'), '/')[4]",
              "resourcetype": "Log Analytics Workspace",
              "resourcename": "@split(appsetting('LAW_RESOURCE_ID'), '/')[8]"
            },
            "body": {
              "query": "@outputs('QueryText')",
              "timerangetype": "3",
              "timerange": {}
            },
            "retryPolicy": {
              "type": "fixed",
              "count": 3,
              "interval": "PT30S"
            }
          }
        },
        "Check_Query_Error": {
          "type": "If",
          "runAfter": {
            "Query": [
              "Succeeded"
            ]
          },
          "expression": {
            "and": [
              {
                "not": {
                  "equals": [
                    "@empty(body('Query')?['error'])",
                    true
                  ]
                }
              }
            ]
          },
          "actions": {
            "Terminate_QueryError": {
              "type": "Terminate",
              "inputs": {
                "runStatus": "Failed",
                "runError": {
                  "code": "QueryError",
                  "message": "Log Analytics returned error/PartialError"
                }
              }
            }
          },
          "else": {
            "actions": {}
          }
        },
        "Rows": {
          "type": "ParseJson",
          "runAfter": {
            "Check_Query_Error": [
              "Succeeded"
            ]
          },
          "inputs": {
            "content": "@body('Query')",
            "schema": {
              "type": "object",
              "required": [
                "value"
              ],
              "properties": {
                "value": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "bag"
                    ]
                  }
                }
              }
            }
          }
        },
        "RowCount": {
          "type": "Compose",
          "runAfter": {
            "Rows": [
              "Succeeded"
            ]
          },
          "inputs": "@length(body('Rows')['value'])"
        },
        "Check_Row_Cap": {
          "type": "If",
          "runAfter": {
            "RowCount": [
              "Succeeded"
            ]
          },
          "expression": {
            "and": [
              {
                "greaterOrEquals": [
                  "@outputs('RowCount')",
                  500000
                ]
              }
            ]
          },
          "actions": {
            "Terminate_RowCap": {
              "type": "Terminate",
              "inputs": {
                "runStatus": "Failed",
                "runError": {
                  "code": "RowCap",
                  "message": "Row count reached API limit; split the window"
                }
              }
            }
          },
          "else": {
            "actions": {}
          }
        },
        "Records": {
          "type": "Select",
          "runAfter": {
            "Check_Row_Cap": [
              "Succeeded"
            ]
          },
          "inputs": {
            "from": "@body('Rows')['value']",
            "select": "@json(string(item()['bag']))"
          }
        },
        "Create_CSV_table": {
          "type": "Table",
          "runAfter": {
            "Records": [
              "Succeeded"
            ]
          },
          "inputs": {
            "from": "@body('Records')",
            "format": "CSV"
          }
        },
        "CsvText": {
          "type": "Compose",
          "runAfter": {
            "Create_CSV_table": [
              "Succeeded"
            ]
          },
          "inputs": "@if(equals(outputs('RowCount'),0), concat(join(outputs('Settings_Columns'),','), decodeUriComponent('%0D%0A')), body('Create_CSV_table'))"
        },
        "Check_Header": {
          "type": "If",
          "runAfter": {
            "CsvText": [
              "Succeeded"
            ]
          },
          "expression": {
            "and": [
              {
                "not": {
                  "equals": [
                    "@trim(first(split(outputs('CsvText'), decodeUriComponent('%0A'))))",
                    "@join(outputs('Settings_Columns'),',')"
                  ]
                }
              }
            ]
          },
          "actions": {
            "Terminate_SchemaMismatch": {
              "type": "Terminate",
              "inputs": {
                "runStatus": "Failed",
                "runError": {
                  "code": "SchemaMismatch",
                  "message": "CSV header differs from expected columns"
                }
              }
            }
          },
          "else": {
            "actions": {}
          }
        },
        "Upload_CSV": {
          "type": "ServiceProvider",
          "runAfter": {
            "Check_Header": [
              "Succeeded"
            ]
          },
          "inputs": {
            "serviceProviderConfiguration": {
              "connectionName": "AzureBlob",
              "operationId": "uploadBlob",
              "serviceProviderId": "/serviceProviders/AzureBlob"
            },
            "parameters": {
              "containerName": "exports",
              "blobName": "@{outputs('Month')}/runs/@{workflow().run.name}/export.csv",
              "content": "@concat(uriComponentToString('%EF%BB%BF'), outputs('CsvText'))",
              "overrideIfExists": "true"
            },
            "retryPolicy": {
              "type": "fixed",
              "count": 3,
              "interval": "PT10S"
            }
          }
        },
        "Manifest": {
          "type": "Compose",
          "runAfter": {
            "Upload_CSV": [
              "Succeeded"
            ]
          },
          "inputs": {
            "month": "@{outputs('Month')}",
            "runId": "@{workflow().run.name}",
            "windowStartUtc": "@{outputs('StartUtc')}",
            "windowEndUtc": "@{outputs('EndUtc')}",
            "rowCount": "@outputs('RowCount')",
            "files": [
              "export.csv"
            ],
            "completedAtUtc": "@{utcNow()}"
          }
        },
        "Upload_Manifest": {
          "type": "ServiceProvider",
          "runAfter": {
            "Manifest": [
              "Succeeded"
            ]
          },
          "inputs": {
            "serviceProviderConfiguration": {
              "connectionName": "AzureBlob",
              "operationId": "uploadBlob",
              "serviceProviderId": "/serviceProviders/AzureBlob"
            },
            "parameters": {
              "containerName": "exports",
              "blobName": "@{outputs('Month')}/runs/@{workflow().run.name}/manifest.json",
              "content": "@string(outputs('Manifest'))",
              "overrideIfExists": "true"
            },
            "retryPolicy": {
              "type": "fixed",
              "count": 3,
              "interval": "PT10S"
            }
          }
        },
        "Current": {
          "type": "Compose",
          "runAfter": {
            "Upload_Manifest": [
              "Succeeded"
            ]
          },
          "inputs": {
            "runId": "@{workflow().run.name}",
            "path": "@{outputs('Month')}/runs/@{workflow().run.name}/"
          }
        },
        "Upload_Current": {
          "type": "ServiceProvider",
          "runAfter": {
            "Current": [
              "Succeeded"
            ]
          },
          "inputs": {
            "serviceProviderConfiguration": {
              "connectionName": "AzureBlob",
              "operationId": "uploadBlob",
              "serviceProviderId": "/serviceProviders/AzureBlob"
            },
            "parameters": {
              "containerName": "exports",
              "blobName": "@{outputs('Month')}/current.json",
              "content": "@string(outputs('Current'))",
              "overrideIfExists": "true"
            },
            "retryPolicy": {
              "type": "fixed",
              "count": 3,
              "interval": "PT10S"
            }
          }
        }
      }
    },
    "Fail_if_Export_Failed": {
      "type": "Terminate",
      "runAfter": {
        "Export": [
          "Failed",
          "TimedOut"
        ]
      },
      "inputs": {
        "runStatus": "Failed",
        "runError": {
          "code": "ExportFailed",
          "message": "Export scope failed; inspect actions and stored current.json before retrying"
        }
      }
    }
  },
  "outputs": {}
}
