              "inputs": "@if(empty(parameters('MONTH_OVERRIDE')), addToTime(formatDateTime(convertTimeZone(utcNow(),'UTC','Tokyo Standard Time'),'yyyy-MM-01T00:00:00'),-1,'Month','yyyy-MM-ddTHH:mm:ss'), concat(parameters('MONTH_OVERRIDE'),'-01T00:00:00'))"
